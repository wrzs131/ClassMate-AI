# =====================================================================
# ClassMate AI 后端环境变量模板
# 用法：复制为 backend/.env 后填写真实值
# =====================================================================

api_key=sk-your-siliconflow-key
base_url=https://api.siliconflow.cn/v1
model_name=Qwen/Qwen3-VL-32B-Instruct
embedding_model=Qwen/Qwen3-Embedding-8B

temperature=0.3
max_tokens=4096
# 单次模型调用超时（秒）。整份课件 JSON 较大，建议 240~300
request_timeout=300

# 可选：关闭真实模型，走确定性演示逻辑（便于离线答辩）
use_llm=true

# Chroma 向量检索开关（默认关闭，检索会降级为关键词匹配，功能不缺失）
# 运行环境为 Python 3.13（numpy 2.x + chromadb 1.5.x + langchain-chroma 1.1.x）。
# 本机 chromadb 执行 add 时可能因 chroma-hnswlib ABI 崩溃（0xC0000005），
# 请先运行 `python scripts/check_vector.py`（子进程隔离）通过后再打开。
enable_vector=false

# 服务
host=0.0.0.0
port=8001
